let CollectionWindow = 30m;
let FileActivity = DeviceFileEvents
| where Timestamp > ago(7d)
| where ActionType in ("FileCreated", "FileRenamed", "FileModified", "FileRead")
| where FolderPath matches regex @"(?i)(/tmp/|/var/tmp/|\\temp\\|\\appdata\\local\\temp\\)"
   or FileName matches regex @"(?i)\.(zip|7z|rar|tar|gz)$"
| project DeviceId, DeviceName, FileTime=Timestamp, FolderPath, FileName,
          FileSize, InitiatingProcessFileName, InitiatingProcessCommandLine;
let DnsUpload = DeviceNetworkEvents
| where Timestamp > ago(7d)
| where RemotePort == 53
| where RemoteUrl matches regex @"(^|\.)3x[67]-\.\d+-\."
| project DeviceId, DnsTime=Timestamp, RemoteUrl, RemoteIP,
          DnsProcess=InitiatingProcessFileName;
FileActivity
| join kind=inner DnsUpload on DeviceId
| where DnsTime between (FileTime .. FileTime + CollectionWindow)
| project DeviceName, FileTime, DnsTime, FolderPath, FileName,
          FileSize, InitiatingProcessFileName,
          InitiatingProcessCommandLine, RemoteUrl, RemoteIP, DnsProcess
