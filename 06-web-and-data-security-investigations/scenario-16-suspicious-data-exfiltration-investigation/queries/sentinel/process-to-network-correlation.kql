let Lookback = 30m;
let SuspiciousProcesses = DeviceProcessEvents
| where Timestamp > ago(7d)
| where ProcessCommandLine has_all ("base64", "dig")
   or ProcessCommandLine matches regex @"gzip\s+-c.*\|.*base64.*\|.*dig"
| project DeviceId, DeviceName, ProcessTime=Timestamp,
          InitiatingProcessAccountName, FileName, ProcessCommandLine,
          ProcessId, InitiatingProcessId;
let SuspiciousDns = DeviceNetworkEvents
| where Timestamp > ago(7d)
| where RemotePort == 53
| where RemoteUrl matches regex @"(^|\.)3x[67]-\.\d+-\."
| project DeviceId, DnsTime=Timestamp, RemoteUrl, RemoteIP, RemotePort,
          DnsInitiatingProcessFileName=InitiatingProcessFileName,
          DnsInitiatingProcessId=InitiatingProcessId;
SuspiciousProcesses
| join kind=inner SuspiciousDns on DeviceId
| where DnsTime between (ProcessTime .. ProcessTime + Lookback)
| where ProcessId == DnsInitiatingProcessId
| project DeviceName, ProcessTime, DnsTime, FileName, ProcessCommandLine,
          RemoteUrl, RemoteIP, RemotePort, ProcessId, DnsInitiatingProcessId,
          DnsInitiatingProcessFileName
