index=endpoint sourcetype=*file*
(action=created OR action=renamed OR action=modified OR action=read)
(file_path="*/tmp/*" OR file_path="*\\Temp\\*" OR file_name="*.zip" OR file_name="*.7z" OR file_name="*.gz")
| eval host_key=coalesce(dest, host, device_name)
| rename _time as file_time
| table host_key file_time user file_path file_name file_size process_name process_id
| join type=inner host_key
    [ search index=dns earliest=-7d
      | eval query=lower(coalesce(query, query_name, dns_query))
      | where match(query,"(^|\\.)3x[67]-\\.\\d+-\\.")
      | eval host_key=coalesce(src_host, src, host)
      | rename _time as dns_time
      | table host_key dns_time query dest_ip ]
| where dns_time>=file_time AND dns_time<=file_time+1800
