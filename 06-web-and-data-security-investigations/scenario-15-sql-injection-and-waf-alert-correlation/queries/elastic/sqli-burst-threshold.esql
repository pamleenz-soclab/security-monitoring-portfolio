FROM waf-*
| WHERE TO_STRING(waf.rule.id) LIKE "942%"
| EVAL bucket=DATE_TRUNC(5 minutes, @timestamp)
| STATS request_count=COUNT_DISTINCT(waf.transaction_id), distinct_rules=COUNT_DISTINCT(waf.rule.id), distinct_paths=COUNT_DISTINCT(url.path), first_seen=MIN(@timestamp), last_seen=MAX(@timestamp) BY bucket, source.ip, url.domain, user_agent.original
| WHERE request_count >= 20 AND (distinct_paths >= 3 OR distinct_rules >= 2)
| SORT request_count DESC
