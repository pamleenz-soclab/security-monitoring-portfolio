let Window = 10m;
let MinUsers = 5;
SigninLogs
| where ResultType == "50126"
| summarize AttemptCount=count(),
            DistinctUsers=dcount(UserPrincipalName),
            Users=make_set(UserPrincipalName, 50),
            Apps=make_set(AppDisplayName, 20),
            FirstSeen=min(TimeGenerated),
            LastSeen=max(TimeGenerated)
  by IPAddress, bin(TimeGenerated, Window)
| where DistinctUsers >= MinUsers
| project FirstSeen, LastSeen, IPAddress, AttemptCount, DistinctUsers, Users, Apps
| order by DistinctUsers desc
