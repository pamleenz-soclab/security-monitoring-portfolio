let Window = 10m;
let MinUsers = 5;
let MaxAttemptsPerUser = 3;
SigninLogs
| where ResultType == "50126"
| extend WindowStart = bin(TimeGenerated, Window)
| summarize UserAttempts=count(), Apps=make_set(AppDisplayName, 20)
  by IPAddress, WindowStart, UserPrincipalName
| summarize AttemptCount=sum(UserAttempts),
            DistinctUsers=dcount(UserPrincipalName),
            MaxUserAttempts=max(UserAttempts),
            Users=make_set(UserPrincipalName, 50),
            Apps=make_set(Apps, 50)
  by IPAddress, WindowStart
| where DistinctUsers >= MinUsers and MaxUserAttempts <= MaxAttemptsPerUser
| project WindowStart, IPAddress, AttemptCount, DistinctUsers,
          MaxUserAttempts, Users, Apps
| order by DistinctUsers desc
