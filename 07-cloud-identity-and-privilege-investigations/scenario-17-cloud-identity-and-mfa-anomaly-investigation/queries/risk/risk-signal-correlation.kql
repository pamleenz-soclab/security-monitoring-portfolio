AADUserRiskEvents
| where UserPrincipalName =~ "<USER>"
| extend RiskTime=coalesce(ActivityDateTime, TimeGenerated)
| project RiskTime, UserPrincipalName, Activity, RiskEventType,
          RiskLevel, RiskState, CorrelationId, RequestId, RiskIPAddress=IpAddress
| join kind=leftouter (
    SigninLogs
    | project SignInTime=TimeGenerated, UserPrincipalName, SignInIP=IPAddress,
              AppDisplayName, ResultType, CorrelationId,
              RequestId=OriginalRequestId, SessionId
) on CorrelationId
| extend RequestIdMatch = isnotempty(RequestId) and RequestId == RequestId1
| project RiskTime, SignInTime, UserPrincipalName, RiskIPAddress, SignInIP,
          RiskEventType, RiskLevel, RiskState, AppDisplayName, ResultType,
          CorrelationId, RiskRequestId=RequestId, SignInRequestId=RequestId1,
          RequestIdMatch, SessionId
| order by RiskTime asc
