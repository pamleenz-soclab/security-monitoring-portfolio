FROM logs-cloud_identity-*
| WHERE event.dataset == "entra.audit" AND (event.action LIKE "*credentials*" OR event.action LIKE "*Certificates and secrets management*")
| WHERE entra.credential.key_id IS NOT NULL
| KEEP @timestamp, user.id, source.ip, entra.target.id, entra.target.type, entra.credential.type, entra.credential.key_id, entra.credential.display_name
