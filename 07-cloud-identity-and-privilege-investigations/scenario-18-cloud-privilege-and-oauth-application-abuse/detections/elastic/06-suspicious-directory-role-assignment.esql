FROM logs-cloud_identity-*
| WHERE event.dataset == "entra.audit" AND entra.audit.category == "RoleManagement"
| WHERE event.action LIKE "*Add member to role*" OR event.action LIKE "*Add eligible member to role*"
| KEEP @timestamp, user.id, source.ip, entra.target.id, entra.target.type, entra.role.name, entra.assignment.type, entra.assignment.schedule_type, event.outcome
