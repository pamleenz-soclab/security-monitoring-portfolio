// Candidate generator only. "Unusual" requires an approved administrator baseline or enrichment.
// Do not alert solely because one of these changes occurred.
FROM logs-cloud_identity-*
| WHERE event.dataset == "entra.audit" AND entra.activity.family == "application_privilege_change" AND @timestamp > NOW() - 1 day
| STATS recent_operations=VALUES(event.action), recent_ips=VALUES(source.ip),
        target_ids=VALUES(entra.target.id), changes=COUNT(*)
  BY user.id
| WHERE changes > 0
