FROM logs-cloud_identity-*
| WHERE event.dataset == "entra.audit" AND event.action LIKE "*federated identity credential*"
| KEEP @timestamp, user.id, entra.initiator.app_id, entra.initiator.service_principal_id, entra.application.object_id, entra.federated_credential.id, entra.federated_credential.issuer, entra.federated_credential.subject, entra.federated_credential.audiences, event.outcome
