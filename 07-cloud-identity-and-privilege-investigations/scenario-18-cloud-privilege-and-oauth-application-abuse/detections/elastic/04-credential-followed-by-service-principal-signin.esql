// Requires an enrichment or sequence rule keyed on entra.credential.id.
FROM logs-cloud_identity-*
| WHERE event.dataset IN ("entra.audit", "entra.service_principal_signin")
| EVAL credential_id = COALESCE(entra.credential.key_id, entra.signin.credential_key_id, entra.signin.federated_credential_id)
| WHERE credential_id IS NOT NULL
| STATS first_add=MIN(CASE(event.dataset == "entra.audit", @timestamp, NULL)), first_signin=MIN(CASE(event.dataset == "entra.service_principal_signin", @timestamp, NULL)), values=VALUES(event.dataset) BY credential_id, entra.service_principal.id
| WHERE first_add IS NOT NULL AND first_signin IS NOT NULL AND first_signin >= first_add
