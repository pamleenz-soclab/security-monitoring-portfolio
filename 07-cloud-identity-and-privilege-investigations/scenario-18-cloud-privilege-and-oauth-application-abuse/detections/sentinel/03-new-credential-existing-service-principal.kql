AuditLogs
| where TimeGenerated > ago(1d)
| where coalesce(ActivityDisplayName, OperationName) has_any ("Add service principal credentials", "Certificates and secrets management", "Update application")
| extend Targets=parse_json(TargetResources), Initiator=parse_json(InitiatedBy)
| mv-expand Target=Targets
| mv-expand Property=todynamic(Target.modifiedProperties)
| extend PropertyName=tostring(Property.displayName), NewValue=tostring(Property.newValue)
| where PropertyName has_any ("PasswordCredentials", "KeyDescription", "KeyCredentials")
| where NewValue !in ("", "[]", "null")
| project TimeGenerated, Activity=coalesce(ActivityDisplayName, OperationName),
          TargetId=tostring(Target.id), TargetType=tostring(Target.type), CredentialMetadata=NewValue,
          InitiatorUserId=tostring(Initiator.user.id), InitiatorAppId=tostring(Initiator.app.appId),
          InitiatorIP=tostring(Initiator.user.ipAddress), Result, CorrelationId
