let SensitivePaths = dynamic(["/applications","/servicePrincipals","/roleManagement","/sites","/drives","/users","/groups"]);
let Grants = AuditLogs
| where TimeGenerated > ago(1d)
| where coalesce(ActivityDisplayName, OperationName) has "Add app role assignment"
| extend Targets=parse_json(TargetResources)
| mv-expand Target=Targets
| where tostring(Target.type) =~ "ServicePrincipal"
| project GrantTime=TimeGenerated, ClientServicePrincipalId=tostring(Target.id), GrantOperation=coalesce(ActivityDisplayName, OperationName), GrantCorrelationId=CorrelationId;
Grants
| join kind=inner (
    MicrosoftGraphActivityLogs
    | where TimeGenerated > ago(1d)
    | where ResponseStatusCode between (200 .. 299)
    | where RequestUri has_any (SensitivePaths)
    | project ApiTime=TimeGenerated, ServicePrincipalId, AppId, RequestMethod, RequestUri, RequestId, ResponseStatusCode, IPAddress
) on $left.ClientServicePrincipalId == $right.ServicePrincipalId
| where ApiTime between (GrantTime .. GrantTime + 24h)
| project GrantTime, ApiTime, ServicePrincipalId, AppId, RequestMethod, RequestUri, RequestId, IPAddress, GrantCorrelationId
