AuditLogs
| where TimeGenerated > ago(1d)
| where coalesce(ActivityDisplayName, OperationName) has "federated identity credential"
| extend Initiator=parse_json(InitiatedBy), Targets=parse_json(TargetResources)
| mv-expand Target=Targets
| mv-expand Property=todynamic(Target.modifiedProperties)
| extend PropertyName=tostring(Property.displayName), NewValue=tostring(Property.newValue)
| where PropertyName has "FederatedIdentityCredentials" or coalesce(ActivityDisplayName, OperationName) startswith "Add federated"
| project TimeGenerated, Activity=coalesce(ActivityDisplayName, OperationName),
          TargetApplicationObjectId=tostring(Target.id), TargetName=tostring(Target.displayName),
          FederatedCredentialMetadata=NewValue, InitiatorUserId=tostring(Initiator.user.id),
          InitiatorAppId=tostring(Initiator.app.appId), InitiatorServicePrincipalId=tostring(Initiator.app.servicePrincipalId),
          Result, CorrelationId, AdditionalDetails
