let Lookback = 1d;
let CredentialAdds = AuditLogs
| where TimeGenerated > ago(Lookback)
| where coalesce(ActivityDisplayName, OperationName) has_any ("Add service principal credentials", "Certificates and secrets management", "Add federated identity credential")
| extend Targets=parse_json(TargetResources)
| mv-expand Target=Targets
| mv-expand Property=todynamic(Target.modifiedProperties)
| extend NewValue=tostring(Property.newValue), TargetId=tostring(Target.id)
| extend CredentialIds=extract_all(@"[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}", NewValue)
| mv-expand CredentialId=CredentialIds
| project CredentialAddedTime=TimeGenerated, TargetId, CredentialId=tostring(CredentialId), AuditCorrelationId=CorrelationId;
CredentialAdds
| join kind=inner (
    AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(Lookback)
    | where ResultType == "0" or ResultType == 0
    | extend CredentialId=coalesce(ServicePrincipalCredentialKeyId, FederatedCredentialId)
    | project SignInTime=TimeGenerated, ServicePrincipalId, AppId, CredentialId,
              ClientCredentialType, IPAddress, ResourceDisplayName, UniqueTokenIdentifier, SignInId=Id
) on CredentialId
| where SignInTime between (CredentialAddedTime .. CredentialAddedTime + 24h)
| project CredentialAddedTime, SignInTime, CredentialId, TargetId, ServicePrincipalId, AppId,
          ClientCredentialType, IPAddress, ResourceDisplayName, UniqueTokenIdentifier, SignInId
