// Correlate a newly added credential ID with a later successful service-principal sign-in.
// Audit credential changes can contain both old and new credential arrays, so subtract old IDs from new IDs.
let Lookback = 1d;
let UuidPattern = @"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}";
let CredentialAdds = AuditLogs
| where TimeGenerated > ago(Lookback)
| where coalesce(ActivityDisplayName, OperationName) has_any
    ("Add service principal credentials", "Certificates and secrets management", "Add federated identity credential")
| extend Targets=todynamic(TargetResources)
| mv-expand Target=Targets
| mv-expand Property=todynamic(Target.modifiedProperties)
| extend PropertyName=tostring(Property.displayName),
         NewValue=tostring(Property.newValue),
         OldValue=tostring(Property.oldValue),
         TargetId=tostring(Target.id),
         TargetType=tostring(Target.type)
| where PropertyName has_any ("PasswordCredentials", "KeyCredentials", "FederatedIdentityCredentials", "KeyDescription")
| extend NewIds=extract_all(UuidPattern, NewValue), OldIds=extract_all(UuidPattern, OldValue)
| extend AddedIds=set_difference(NewIds, OldIds)
| mv-expand CredentialId=AddedIds
| where isnotempty(CredentialId)
| project CredentialAddedTime=TimeGenerated, TargetId, TargetType,
          CredentialId=tostring(CredentialId), AuditCorrelationId=CorrelationId;
CredentialAdds
| join kind=inner (
    AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(Lookback)
    | where ResultType == 0
    | extend CredentialId=coalesce(ServicePrincipalCredentialKeyId, FederatedCredentialId)
    | where isnotempty(CredentialId)
    | project SignInTime=TimeGenerated, ServicePrincipalId, AppId, CredentialId,
              ClientCredentialType, IPAddress, ResourceDisplayName,
              UniqueTokenIdentifier, SignInId=Id
) on CredentialId
| where SignInTime between (CredentialAddedTime .. CredentialAddedTime + 24h)
| project CredentialAddedTime, SignInTime, CredentialId, TargetId, TargetType,
          ServicePrincipalId, AppId, ClientCredentialType, IPAddress,
          ResourceDisplayName, UniqueTokenIdentifier, SignInId, AuditCorrelationId
