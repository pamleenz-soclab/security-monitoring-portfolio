index=cloud_identity earliest=-1d (sourcetype=entra:audit OR sourcetype=entra:service_principal_signin)
| eval credential_id=coalesce(credential_key_id, service_principal_credential_key_id, federated_credential_id)
| stats earliest(eval(if(sourcetype="entra:audit",_time,null()))) as credential_add_time,
        earliest(eval(if(sourcetype="entra:service_principal_signin",_time,null()))) as signin_time,
        values(service_principal_id) as service_principal_id values(app_id) as app_id,
        values(client_credential_type) as client_credential_type values(src_ip) as src_ip,
        values(unique_token_identifier) as token_id by credential_id
| where isnotnull(credential_add_time) AND isnotnull(signin_time) AND signin_time>=credential_add_time AND signin_time<=credential_add_time+86400
