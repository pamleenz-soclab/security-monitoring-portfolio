// R19-04 v3. Native Elastic execution: NOT TESTED; validate date arithmetic and vendor field mappings natively.
FROM logs-cloud_identity-*
| WHERE event.dataset IN ("entra.audit", "entra.service_principal_signin")
| EVAL credential_id=COALESCE(entra.credential.key_id, entra.signin.credential_key_id, entra.signin.federated_credential_id), service_principal_id=COALESCE(entra.service_principal.id, entra.audit.target_service_principal_id)
| WHERE credential_id IS NOT NULL AND service_principal_id IS NOT NULL
| EVAL is_add=event.dataset == "entra.audit" AND event.action IN ("Add service principal credentials", "Certificates and secrets management", "Add federated identity credential"), is_success_signin=event.dataset == "entra.service_principal_signin" AND event.outcome == "success"
| STATS first_add=MIN(CASE(is_add, @timestamp, NULL)), first_signin=MIN(CASE(is_success_signin, @timestamp, NULL)) BY credential_id, service_principal_id
| WHERE first_add IS NOT NULL AND first_signin IS NOT NULL AND first_signin >= first_add AND first_signin <= first_add + 24 hours
