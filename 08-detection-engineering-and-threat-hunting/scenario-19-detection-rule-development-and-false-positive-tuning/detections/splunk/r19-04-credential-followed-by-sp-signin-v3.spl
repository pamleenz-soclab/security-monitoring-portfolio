# R19-04 v3. Native Splunk execution: NOT TESTED.
index=cloud_identity earliest=-2d (sourcetype=entra:audit OR sourcetype=entra:service_principal_signin)
| eval credential_id=coalesce(credential_key_id,service_principal_credential_key_id,federated_credential_id)
| eval service_principal_id=coalesce(service_principal_id,target_service_principal_id)
| eval is_add=if(sourcetype="entra:audit" AND operation IN ("Add service principal credentials","Certificates and secrets management","Add federated identity credential"),1,0)
| eval is_success_signin=if(sourcetype="entra:service_principal_signin" AND result="success",1,0)
| where isnotnull(credential_id) AND isnotnull(service_principal_id)
| stats earliest(eval(if(is_add=1,_time,null()))) as credential_add_time earliest(eval(if(is_success_signin=1,_time,null()))) as signin_time values(app_id) as app_id values(src_ip) as src_ip by service_principal_id credential_id
| where isnotnull(credential_add_time) AND isnotnull(signin_time) AND signin_time>=credential_add_time AND signin_time<=credential_add_time+86400
