// R19-04 v3. Native Sentinel execution: NOT TESTED.
let Lookback = 2d;
let Adds = AuditLogs
| where TimeGenerated > ago(Lookback)
| where coalesce(ActivityDisplayName, OperationName) has_any ("Add service principal credentials", "Certificates and secrets management", "Add federated identity credential")
| extend Targets=parse_json(TargetResources)
| mv-expand Target=Targets
| mv-expand Property=todynamic(Target.modifiedProperties)
| extend NewValue=tostring(Property.newValue), ServicePrincipalId=tostring(Target.id)
| extend CredentialIds=extract_all(@"[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}", NewValue)
| mv-expand CredentialId=CredentialIds
| project CredentialAddedTime=TimeGenerated, ServicePrincipalId, CredentialId=tostring(CredentialId), AuditCorrelationId=CorrelationId;
let Signins = AADServicePrincipalSignInLogs
| where TimeGenerated > ago(Lookback)
| where ResultType == "0" or ResultType == 0
| extend CredentialId=tostring(coalesce(ServicePrincipalCredentialKeyId, FederatedCredentialId))
| project SignInTime=TimeGenerated, ServicePrincipalId=tostring(ServicePrincipalId), CredentialId, AppId, ClientCredentialType, IPAddress, ResourceDisplayName, SignInId=Id;
Adds
| join kind=inner Signins on ServicePrincipalId, CredentialId
| where SignInTime between (CredentialAddedTime .. CredentialAddedTime + 24h)
| project CredentialAddedTime, SignInTime, ServicePrincipalId, CredentialId, AppId, ClientCredentialType, IPAddress, ResourceDisplayName, SignInId, AuditCorrelationId
